# Copiez ce fichier en .env à la racine avant docker compose.
# Ces valeurs sont intégrées aux bundles publics du navigateur.
VITE_API_URL=/api
VITE_FEDAPAY_PUBLIC_KEY=
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_SANDBOX=true

# Configuration Firebase du client (valeurs publiques, à restreindre dans Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
