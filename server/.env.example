NODE_ENV=production
PORT=8000

# MongoDB — utilisez une base dédiée à cette boutique.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Générez des secrets JWT longs et uniques pour chaque déploiement.
SECRET_KEY_ACCESS_TOKEN=replace-with-a-long-random-secret
SECRET_KEY_REFRESH_TOKEN=replace-with-another-long-random-secret
JSON_WEB_TOKEN_SECRET_KEY=replace-with-a-third-long-random-secret

# URL publique de la boutique et origine autorisée (sans barre oblique finale).
CLIENT_URL=https://your-store.example
ALLOWED_ORIGINS=https://your-store.example

# Firebase Auth redirect helper proxy (use the Firebase project's firebaseapp.com host).
FIREBASE_AUTH_PROXY_HOST=your-project.firebaseapp.com

# KkiaPay : restez en Sandbox jusqu'à la configuration des clés de production.
KKIAPAY_SANDBOX=true
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# Secret de vérification configuré pour le webhook KkiaPay.
KKIAPAY_WEBHOOK_SECRET=

# FedaPay : environment peut être sandbox ou live selon le compte et les clés.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
# Secret unique de l'endpoint webhook FedaPay pour cet environnement.
FEDAPAY_WEBHOOK_SECRET=

# SMTP pour les reçus et les e-mails de vérification.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL=

# Cloudinary — requis pour les téléversements d'images depuis l'admin.
cloudinary_Config_Cloud_Name=
cloudinary_Config_api_key=
cloudinary_Config_api_secret=

# Optionnel : génération de contenu marketing par IA.
GROQ_API_KEY=
